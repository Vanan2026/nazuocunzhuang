extends Node

signal game_initialized
signal day_changed(day: int)
signal season_changed(season: String)

var current_day: int = 1
var current_season: String = "spring"
var time_of_day: float = 0.0

var TimeSystem: Node
var EventSystem: Node

func _ready() -> void:
    initialize_systems()

func initialize_systems() -> void:
    if has_node("/root/TimeSystem"):
        TimeSystem = get_node("/root/TimeSystem")
    else:
        var time_script = load("res://scripts/time_system.gd")
        if time_script == null:
            push_error("[GameManager] 无法加载 time_system.gd 脚本")
            return
        var ts = Node.new()
        ts.set_script(time_script)
        ts.name = "TimeSystem"
        add_child(ts)
        TimeSystem = ts

    if has_node("/root/EventSystem"):
        EventSystem = get_node("/root/EventSystem")
    else:
        var event_script = load("res://scripts/event_system.gd")
        if event_script == null:
            push_error("[GameManager] 无法加载 event_system.gd 脚本")
            return
        var es = Node.new()
        es.set_script(event_script)
        es.name = "EventSystem"
        add_child(es)
        EventSystem = es

    emit_signal("game_initialized")
