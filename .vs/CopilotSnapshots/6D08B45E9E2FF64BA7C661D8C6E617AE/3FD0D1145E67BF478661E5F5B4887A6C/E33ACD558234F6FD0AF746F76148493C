extends Node

var event_registry: Dictionary = {}
var active_events: Array = []
var daily_events: Array = []

signal event_triggered(event_name: String)
signal event_completed(event_name: String)

func _ready() -> void:
    register_default_events()

func register_default_events() -> void:
    event_registry["spring_cherry_blossom"] = {
        "trigger": "season_start",
        "season": "spring",
        "message": "樱花瓣随风飘落，云村迎来了春天...",
        "once_per_season": true
    }
    
    event_registry["summer_fireflies"] = {
        "trigger": "season_time",
        "season": "summer",
        "time": "night",
        "message": "夏夜的萤火虫点亮了听雨林..."
    }
    
    event_registry["autumn_leaves"] = {
        "trigger": "season_start",
        "season": "autumn", 
        "message": "枫叶红了，秋天悄然而至..."
    }
    
    event_registry["winter_first_snow"] = {
        "trigger": "season_start",
        "season": "winter",
        "message": "初雪落在了云隐神社的鸟居上..."
    }
    
    event_registry["morning_mist"] = {
        "trigger": "time_of_day",
        "time": "morning",
        "message": "晨雾笼罩着云村，一切都很宁静..."
    }
    
    event_registry["evening_bell"] = {
        "trigger": "time_of_day",
        "time": "evening",
        "message": "远处传来云隐神社的晚钟声..."
    }

func check_events(time_info: Dictionary) -> void:
    for event_name in event_registry:
        var event = event_registry[event_name]
        if should_trigger(event, time_info):
            trigger_event(event_name, event)

func should_trigger(event: Dictionary, time_info: Dictionary) -> bool:
    var trigger_type = event.get("trigger", "")
    match trigger_type:
        "season_start":
            return time_info.get("season") == event.get("season") and time_info.get("day") == 1
        "time_of_day":
            return time_info.get("time_of_day") == event.get("time")
    return false

func trigger_event(event_name: String, event: Dictionary) -> void:
    emit_signal("event_triggered", event_name)
    print("[Event] ", event.get("message", ""))
    active_events.append(event_name)
