; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="那个村庄"
config/description="治愈系乡村生活模拟 - 2D连续世界探索"
run/main_scene="res://scenes/world/world.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://icon.svg"

[autoload]

Globals="*res://scripts/core/globals.gd"
AudioManager="res://scripts/core/audio_manager.gd"
GameManager="res://scripts/game_manager.gd"
TimeSystem="res://scripts/time_system.gd"
EventSystem="res://scripts/event_system.gd"
SceneManager="res://scripts/scene_manager.gd"
NpcManager="res://scripts/npc_manager.gd"
InteractionHintUI="res://scripts/world/interaction_hint_ui.gd"
UIManager="res://scripts/ui/ui_manager.gd"
SaveSystem="res://scripts/save_system.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg", "res://addons/village_layer_tool/plugin.cfg")

