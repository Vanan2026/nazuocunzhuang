[sub_resource type="GDScript" id="GDScript_backyard_entrance"]
script/source = "extends Area2D

@export var target_scene: String = 'res://scenes/world/cloud_village.tscn'
@export var interaction_hint: String = '按 E 前往农地'

func _ready() -> void:
    body_entered.connect(_on_body_entered)
    body_exited.connect(_on_body_exited)
    add_to_group('scene_exit')
    add_to_group('interactable')

func _on_body_entered(body: Node) -> void:
    if body.is_in_group('player'):
        _show_hint(true)

func _on_body_exited(body: Node) -> void:
    if body.is_in_group('player'):
        _show_hint(false)

func on_interact(_interactor: Node) -> void:
    if target_scene.is_empty():
        return
    get_tree().call_deferred('change_scene_to_file', target_scene)

func _show_hint(show: bool) -> void:
    var hint := get_node_or_null('HintLabel')
    if hint:
        hint.visible = show

func get_interaction_hint() -> String:
    return interaction_hint
"

