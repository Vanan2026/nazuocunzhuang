[sub_resource type="GDScript" id="GDScript_scene"]
script/source = "extends Node2D

func _ready() -> void:
    print('[场景] 云村后院加载完成')
    
    if has_node('/root/AudioManager'):
        var audio = get_node('/root/AudioManager')
        audio.play_bgm('res://audio/bgm/Sunlight_on_the_Veranda.mp3', true)
        print('[场景] 播放背景音乐: Sunlight_on_the_Veranda')
"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_interaction"]
size = Vector2(48, 48)

[sub_resource type="GDScript" id="GDScript_farm_plot"]
script/source = "extends Area2D

@export var enabled: bool = false
@export var plot_index: int = 0
@export var interaction_hint: String = '按 E 查看地块'

func _ready() -> void:
    if not enabled:
        monitoring = false
        monitorable = false
        return
    add_to_group('farm_plot')
    add_to_group('interactable')

func on_interact(_interactor: Node) -> void:
    if not enabled:
        return
    print('[FarmPlot] inspect plot', plot_index)

func get_interaction_hint() -> String:
    if not enabled:
        return ''
    return interaction_hint
"

[sub_resource type="GDScript" id="GDScript_hotspot"]
script/source = "extends Area2D

@export var hotspot_name: String = 'hotspot'
@export var interaction_hint: String = '按 E 观察'
@export var log_message: String = 'inspect hotspot'

func _ready() -> void:
    body_entered.connect(_on_body_entered)
    body_exited.connect(_on_body_exited)
    add_to_group('interactable')

func _on_body_entered(body: Node) -> void:
    if body.is_in_group('player'):
        _show_hint(true)

func _on_body_exited(body: Node) -> void:
    if body.is_in_group('player'):
        _show_hint(false)

func on_interact(_interactor: Node) -> void:
    print('[Hotspot]', hotspot_name, log_message)

func _show_hint(show: bool) -> void:
    var hint := get_node_or_null('HintLabel')
    if hint:
        hint.visible = show

func get_interaction_hint() -> String:
    return interaction_hint
"

