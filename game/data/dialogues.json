    "conditions": {"weather": "rainy", "time_block": "evening", "flag_not_set": "heard_bell_rumor_01"},
    "lines": [
      {"speaker": "hana", "text": "雨天别急着关窗。有时候，远处的铃声会顺着水声过来。"}
    ],
    "sets_flags": ["heard_bell_rumor_01"]
  },
  {
    "dialogue_id": "hana_daily_intent_visit_neighbor_01",
    "npc_id": "hana",
    "type": "daily",
    "priority": 35,
    "conditions": {"season": "any", "weather": "any", "min_hearts": 0, "daily_intent": "visit_neighbor"},
    "lines": [
      {"speaker": "hana", "text": "今天想找人说说话，就从一句问候开始。村里的人慢热，但都记得谁愿意停下来听。"}
    ],
    "sets_flags": []
  },
  {
    "dialogue_id": "hana_daily_intent_visit_neighbor_close_01",
    "npc_id": "hana",
    "type": "relationship",
    "priority": 45,
