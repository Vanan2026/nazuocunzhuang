[
  {
    "dialogue_id": "aoi_weather_rain_01",
    "npc_id": "aoi",
    "type": "weather",
    "priority": 20,
    "conditions": {"season": "any", "weather": "rainy", "min_hearts": 0},
    "lines": [
      {"speaker": "aoi", "text": "下雨天来店里的人少一些，茶水倒是更香。路上慢点走。"}
    ],
    "sets_flags": []
  },
  {
    "dialogue_id": "aoi_daily_spring_01",
    "npc_id": "aoi",
    "type": "daily",
    "priority": 10,
    "conditions": {"season": "spring", "weather": "any", "min_hearts": 0},
    "lines": [
      {"speaker": "aoi", "text": "春天的种子卖得最快。你要是第一次种，萝卜最稳。"}
    ],
    "sets_flags": []
  },
  {
    "dialogue_id": "aoi_fallback_01",
    "npc_id": "aoi",
    "type": "fallback",
    "priority": 0,
    "conditions": {"season": "any", "weather": "any", "min_hearts": 0},
    "lines": [
      {"speaker": "aoi", "text": "缺什么就告诉我，店里能慢慢补齐。"}
    ],
    "sets_flags": []
  },
  {
    "dialogue_id": "aoi_daily_intent_tend_crops_01",
    "npc_id": "aoi",
    "type": "daily",
    "priority": 35,
    "conditions": {"season": "any", "weather": "any", "min_hearts": 0, "daily_intent": "tend_crops"},
    "lines": [
      {"speaker": "aoi", "text": "今天想照看菜地的话，先摸摸土。土不沾手再浇一点水，作物会慢慢认得你的节奏。"}
    ],
    "sets_flags": []
  },
  {
    "dialogue_id": "gen_relationship_01",
    "npc_id": "gen",
    "type": "relationship",
    "priority": 20,
    "conditions": {"season": "any", "weather": "any", "min_hearts": 2},
    "lines": [
      {"speaker": "gen", "text": "你这几天把院子照看得不错。木头也会记住手的温度。"}
    ],
    "sets_flags": []
  },
  {
    "dialogue_id": "gen_daily_wood_01",
    "npc_id": "gen",
    "type": "daily",
    "priority": 10,
    "conditions": {"season": "any", "weather": "any", "min_hearts": 0},
    "lines": [
      {"speaker": "gen", "text": "木头要顺着纹路修。村子也是，急不得。"}
    ],
    "sets_flags": []
  },
  {
    "dialogue_id": "gen_fallback_01",
    "npc_id": "gen",
    "type": "fallback",
    "priority": 0,
    "conditions": {"season": "any", "weather": "any", "min_hearts": 0},
    "lines": [
      {"speaker": "gen", "text": "工具用完收回原处，下次就少找一会儿。"}
    ],
    "sets_flags": []
  },
  {
    "dialogue_id": "gen_daily_intent_repair_material_01",
    "npc_id": "gen",
    "type": "daily",
    "priority": 35,
    "conditions": {"season": "any", "weather": "any", "min_hearts": 0, "daily_intent": "gather_repair_material"},
    "lines": [
      {"speaker": "gen", "text": "今天要整理修复材料，就先捡干燥的木柴和边角石。能用的东西不用急着多，先放在顺手的位置。"}
    ],
    "sets_flags": []
  },
  {
    "dialogue_id": "mika_mailbox_hint_01",
    "npc_id": "mika",
    "type": "daily",
    "priority": 15,
    "conditions": {"season": "any", "weather": "any", "flag_not_set": "read_first_mailbox"},
    "lines": [
      {"speaker": "mika", "text": "邮箱里有时候会放村里的小通知。路过时看看吧。"}
    ],
    "sets_flags": ["mika_hint_mailbox"]
  },
  {
    "dialogue_id": "mika_daily_intent_village_notice_01",
    "npc_id": "mika",
    "type": "daily",
    "priority": 35,
    "conditions": {"season": "any", "weather": "any", "min_hearts": 0, "daily_intent": "check_village_notice"},
    "lines": [
      {"speaker": "mika", "text": "去村口的话，公告牌和旧枫树都顺路。读完别急着走，常有人把小消息贴在边角。"}
    ],
    "sets_flags": []
  },
  {
    "dialogue_id": "mika_daily_intent_village_notice_village_01",
    "npc_id": "mika",
    "type": "daily",
    "priority": 45,
    "conditions": {"season": "any", "weather": "any", "min_hearts": 0, "daily_intent": "check_village_notice", "scene_id": "village"},
    "lines": [
      {"speaker": "mika", "text": "既然已经到村口了，就从公告牌读起，再绕到旧枫树旁。那边的小纸条常被风压在木桩后面。"}
    ],
    "sets_flags": []
  },
  {
    "dialogue_id": "mika_old_well_echo_followup",
    "npc_id": "mika",
    "type": "event",
    "priority": 80,
    "conditions": {"season": "any", "weather": "any", "flag_set": "heard_old_well_echo_after_village_clue_day1", "flag_not_set": "heard_mika_old_well_echo_day1"},
    "lines": [
      {"speaker": "mika", "text": "美香把信包往肩上提了提：旧井会记住很轻的声音。如果它回应你，明天我可以帮你问问谁还记得那条旧路。"}
    ],
    "sets_flags": ["heard_mika_old_well_echo_day1"]
  },
  {
    "dialogue_id": "mika_seasonal_summer_01",
    "npc_id": "mika",
    "type": "seasonal",
    "priority": 12,
    "conditions": {"season": "summer", "weather": "any", "min_hearts": 0},
    "lines": [
      {"speaker": "mika", "text": "夏天送信要趁早，过了午后路边就全是热气。"}
    ],
    "sets_flags": []
  },
  {
    "dialogue_id": "mika_fallback_01",
    "npc_id": "mika",
    "type": "fallback",
    "priority": 0,
    "conditions": {"season": "any", "weather": "any", "min_hearts": 0},
    "lines": [
      {"speaker": "mika", "text": "今天的路很好走，我多绕一圈也没关系。"}
    ],
    "sets_flags": []
  },
  {
    "dialogue_id": "hana_rumor_bell_01",
